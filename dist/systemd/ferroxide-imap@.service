[Unit]
Description=ferroxide IMAP oneshot server

[Service]
User=ferroxide
Group=ferroxide
ExecStart=-/usr/bin/ferroxide --config-home /var/lib/ systemd imap
StandardInput=socket
StandardError=journal

PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=yes
ProtectHome=yes

#MemoryHigh=5M
#MemoryMax=10M
#TasksAccounting=yes
#TasksMax=3
